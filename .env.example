# Postgres
POSTGRES_USER=talasa
POSTGRES_PASSWORD=talasa
POSTGRES_DB=talasa
# Host port for Postgres; override (e.g. 5433) if 5432 is already in use locally
POSTGRES_PORT=5432
DATABASE_URL=postgresql://talasa:talasa@localhost:5432/talasa

# Adminer DB web UI host port; override (e.g. 8082) if 8080 is already in use locally
ADMINER_PORT=8080

# Auth (generate secret: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:3001

# Inference (OpenRouter / OpenAI-compatible) — Counterparty DD synthesis
INFERENCE_URL=https://openrouter.ai/api/v1
INFERENCE_API_KEY=
INFERENCE_MODEL=
# Cheap model for entity disambiguation; blank falls back to INFERENCE_MODEL
DD_RESOLVER_MODEL=
# Optional fallback provider (OpenAI-compatible, e.g. anyapi.ai) tried when the
# primary call fails. Blank URL/key -> no fallback. Model blank -> INFERENCE_MODEL.
INFERENCE_FALLBACK_URL=
INFERENCE_FALLBACK_API_KEY=
INFERENCE_FALLBACK_MODEL=
# Max output tokens per report-writing call (jobs worker)
INFERENCE_MAX_TOKENS=2000
# Chat agent model — must support tool calls. Blank falls back to INFERENCE_MODEL.
CHAT_MODEL=
# Vision model the chat agent uses to read a Sentinel satellite chip
VISION_MODEL=qwen/qwen3-vl-32b-instruct

# OpenSanctions — sanctions / PEP screening. Defaults to a local yente
# (`pnpm yente:up`, see docker-compose.yente.yml), which needs no API key.
# To use the hosted API instead: OPENSANCTIONS_BASE_URL=https://api.opensanctions.org
# plus an OPENSANCTIONS_API_KEY from https://www.opensanctions.org/api/.
OPENSANCTIONS_API_KEY=
OPENSANCTIONS_BASE_URL=http://localhost:8000
# Local yente (docker-compose.yente.yml). `civic` = public data, NON-COMMERCIAL
# use only; `commercial` = licensed data, needs a delivery token from
# https://www.opensanctions.org/account/bulk/.
YENTE_MANIFEST=civic
OPENSANCTIONS_DELIVERY_TOKEN=
YENTE_PORT=8000
# Elasticsearch heap for the yente index; 2g works on smaller machines.
ELASTICSEARCH_HEAP=4g

# Exa (https://exa.ai) — powers the chat agent's live web tools
# (web_search / get_contents / find_similar). Blank = those tools report
# themselves unavailable; the rest of the chat still works.
EXA_API_KEY=

# Equasis (maritime data source) — account for the scraping service
EQUASIS_EMAIL=
EQUASIS_PASSWORD=
EQUASIS_BASE_URL=https://www.equasis.org/EquasisWeb
# Min gap between Equasis requests (serialized throttle). 30s — Equasis flags
# aggressive scraping. A large sister-fleet crawl can then take ~30 min, so keep
# WORKER_LEASE_MINUTES (below) higher than the longest expected run.
EQUASIS_MIN_REQUEST_INTERVAL_MS=30000

# Datalastic (maritime AIS data source) — Starter tier: €199/mo, 20k credits/mo.
# Provides raw AIS: live position (/vessel, /vessel_pro), historical track
# (/vessel_history), area scans (/vessel_inradius), ship specs (/vessel_info).
# Add-on endpoints (SAT-E, Route Tracking, ownership) are NOT in Starter → 403.
DATALASTIC_API_KEY=
DATALASTIC_BASE_URL=https://api.datalastic.com/api/v0
# Min gap between Datalastic requests (serialized throttle, credit-deliberate).
DATALASTIC_MIN_REQUEST_INTERVAL_MS=1000
# AIS lookback window per screening, in days (~1 Datalastic credit per day)
VESSEL_AIS_HISTORY_DAYS=90

# Copernicus Data Space (Sentinel-1 SAR / Sentinel-2 optical) — powers the
# on-demand "Verify with satellite" check on suspected STS events. OAuth client
# credentials from a free https://dataspace.copernicus.eu account. Blank = the
# check is unavailable; everything else works.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_BASE_URL=https://sh.dataspace.copernicus.eu

# Google Maps — reverse-geocodes AIS event coordinates → place labels for
# coastal points in the pipeline (jobs). Needs the Geocoding API enabled. Blank
# is fine: offshore/open-water points are always resolved offline from bundled
# datasets (nearest port + bearing, sea, approximate EEZ), so the key only adds
# street-level names near shore. Can be the same Google Cloud key as the frontend
# VITE_GOOGLE_MAPS_API_KEY below, but keep this one unrestricted /
# server-IP-restricted (it is never exposed to the browser).
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODE_BASE_URL=https://maps.googleapis.com/maps/api/geocode/json
GOOGLE_GEOCODE_MIN_REQUEST_INTERVAL_MS=120

# Counterparty DD worker (apps/jobs) tuning — optional, defaults applied
WORKER_POLL_MS=2000
# Must exceed the longest pipeline run so a second worker doesn't re-claim a
# still-running row and double-scrape Equasis. Raised for the 30s-throttled crawl.
WORKER_LEASE_MINUTES=45

# Vessel Screening sister-fleet crawl caps (apps/jobs)
VESSEL_MAX_SISTERS_PER_COMPANY=25
VESSEL_MAX_SISTER_PAGES=60

# API
PORT=8787

# Frontend (read by Vite via envDir=repo root)
# NOTE: VITE_* are baked into the client bundle at BUILD time, not runtime.
VITE_API_URL=http://localhost:8787
# Browser Google Maps key — powers the interactive AIS event map (Maps
# JavaScript API) and the PDF's static map (Static Maps API). Restrict it by
# HTTP referrer in Google Cloud. Blank → the report lists events without a map.
VITE_GOOGLE_MAPS_API_KEY=
